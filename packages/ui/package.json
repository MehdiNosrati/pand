{
  "name": "@pands/ui",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react --external react-dom",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('@pands/ui ok')\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "tailwind-merge": "^3.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "Tailwind CSS and React component library for Pand applications",
  "license": "MIT",
  "author": "Mehdi Nosrati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/pand.git"
  },
  "homepage": "https://github.com/MehdiNosrati/pand#readme",
  "bugs": {
    "url": "https://github.com/MehdiNosrati/pand/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "src/styles.css"]
}
