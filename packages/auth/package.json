{
  "name": "@pands/auth",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/schema.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pands/config": "workspace:*",
    "@pands/db": "workspace:*",
    "@types/pg": "^8.11.11",
    "better-auth": "^1.2.5",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@pands/testing": "workspace:*",
    "react": "^19.0.0"
  },
  "description": "Better Auth integration, session management, and authentication schema for Pand",
  "license": "MIT",
  "author": "Mehdi Nosrati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/pand.git"
  },
  "homepage": "https://github.com/MehdiNosrati/pand#readme",
  "bugs": {
    "url": "https://github.com/MehdiNosrati/pand/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"]
}
