{
  "name": "@pands/analytics",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/web.tsx src/server.ts --format esm --dts --clean --external react --external react-dom",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "posthog-js": "^1.226.0",
    "posthog-node": "^4.9.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "react": "^19.0.0"
  },
  "description": "PostHog Cloud EU wrapper and web/server analytics for Pand",
  "license": "MIT",
  "author": "Mehdi Nosrati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/pand.git"
  },
  "homepage": "https://github.com/MehdiNosrati/pand#readme",
  "bugs": {
    "url": "https://github.com/MehdiNosrati/pand/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"]
}
