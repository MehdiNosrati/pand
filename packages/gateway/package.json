{
  "name": "@pands/gateway",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@pands/auth": "workspace:*",
    "@pands/config": "workspace:*",
    "@pands/db": "workspace:*",
    "@pands/logger": "workspace:*",
    "@pands/service": "workspace:*",
    "@pands/telemetry": "workspace:*",
    "@scalar/hono-api-reference": "^0.5.170",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@pands/testing": "workspace:*"
  },
  "description": "Reverse proxy, routing, and Better Auth authentication gateway for Pand",
  "license": "MIT",
  "author": "Mehdi Nosrati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/pand.git"
  },
  "homepage": "https://github.com/MehdiNosrati/pand#readme",
  "bugs": {
    "url": "https://github.com/MehdiNosrati/pand/issues"
  },
