{
  "name": "@pands/cli",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "pand": "./bin/pand.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "node -e \"const fs=require('fs'); fs.cpSync('../../templates', './templates', { recursive: true }); fs.cpSync('../../infra', './infra', { recursive: true });\"",
    "postpack": "node -e \"const fs=require('fs'); fs.rmSync('./templates', { recursive: true, force: true }); fs.rmSync('./infra', { recursive: true, force: true });\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pands/auth": "workspace:*",
    "@pands/config": "workspace:*",
    "@pands/db": "workspace:*",
    "@pands/gateway": "workspace:*",
    "@pands/sdk-gen": "workspace:*",
    "@pands/service": "workspace:*",
    "@types/pg": "^8.11.11",
    "age-encryption": "^0.2.3",
    "chokidar": "^4.0.3",
    "citty": "^0.1.6",
    "consola": "^3.4.0",
    "drizzle-orm": "^0.39.3",
    "execa": "^9.5.2",
    "handlebars": "^4.7.8",
    "jiti": "^2.4.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@pands/testing": "workspace:*"
  },
  "description": "Agent-Native Full-Stack Application Platform CLI",
  "license": "MIT",
  "author": "Mehdi Nosrati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehdiNosrati/pand.git"
  },
  "homepage": "https://github.com/MehdiNosrati/pand#readme",
  "bugs": {
    "url": "https://github.com/MehdiNosrati/pand/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "bin", "templates", "infra"]
}
