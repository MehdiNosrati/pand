{
  "uid": "pand-backups-db",
  "title": "Pand Backups & PostgreSQL Health",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Hours Since Last Nightly Backup",
      "type": "stat",
      "targets": [{ "expr": "(time() - pand_backup_last_success_timestamp_seconds) / 3600" }]
    },
    {
      "id": 2,
      "title": "Active PostgreSQL Connections",
      "type": "timeseries",
      "targets": [{ "expr": "pg_stat_activity_count" }]
    }
  ]
}
