{
  "uid": "pand-project-red",
  "title": "Pand Service RED Metrics (Rate, Errors, Duration)",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (pand_project, pand_service) (rate(http_server_requests_total[5m]))" }
      ]
    },
    {
      "id": 2,
      "title": "5xx Error Rate %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum by (pand_project, pand_service) (rate(http_server_requests_total{status=~\"5..\"}[5m])) / sum by (pand_project, pand_service) (rate(http_server_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, pand_project, pand_service) (rate(http_server_duration_milliseconds_bucket[5m])))"
        }
      ]
    }
  ]
}
