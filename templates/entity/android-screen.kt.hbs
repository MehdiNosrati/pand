@Composable
fun {{entity}}Screen(items: List<{{entity}}> = emptyList()) {
    var searchQuery by remember { mutableStateOf("") }
    var showCreateSheet by remember { mutableStateOf(false) }

    Scaffold(
        floatingActionButton = {
            FloatingActionButton(onClick = { showCreateSheet = true }) {
                Text("+")
            }
        }
    ) { innerPadding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
        ) {
            OutlinedTextField(
                value = searchQuery,
                onValueChange = { searchQuery = it },
                label = { Text("Search {{pluralTitle}}") }
            )
            LazyColumn {
                items(items) { item ->
                    Text(text = item.{{displayField}}.toString())
                }
            }
        }
    }
}
