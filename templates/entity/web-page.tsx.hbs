import "@methane-ui/ui/badge";
import "@methane-ui/ui/button";
import "@methane-ui/ui/card";
import "@methane-ui/ui/checkbox";
import "@methane-ui/ui/dialog";
import "@methane-ui/ui/empty-state";
import "@methane-ui/ui/input";
import "@methane-ui/ui/number-input";
import "@methane-ui/ui/search-input";
import "@methane-ui/ui/select";
import "@methane-ui/ui/toast";
import { createPandClient } from "@{{project}}/sdk";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import type React from "react";
import { useState } from "react";

const sdk = createPandClient({ baseUrl: window.location.origin });

export default function {{pluralPascal}}Page() {
  const queryClient = useQueryClient();
  const [search, setSearch] = useState("");
  const [modalOpen, setModalOpen] = useState(false);
  const [toast, setToast] = useState<string | null>(null);
  const [formState, setFormState] = useState<Record<string, any>>({
{{#each fields}}
{{#if hasDefaultValue}}
    {{name}}: {{{defaultValueJson}}},
{{else}}
    {{name}}: {{#if isBoolean}}false{{else}}""{{/if}},
{{/if}}
{{/each}}
  });

  const { data: items = [], isLoading } = useQuery({
    queryKey: ["{{service}}", "{{tableName}}", search],
    queryFn: async () => {
      const qs = search ? `?q=${encodeURIComponent(search)}` : "";
      const { data, error } = await (sdk.GET as any)(`/api/v1/{{service}}/{{pluralKebab}}${qs}`);
      if (error) throw new Error(error?.error?.message ?? "Failed to load {{pluralTitle}}");
      return (data?.items ?? data?.data ?? []) as Array<Record<string, any>>;
    },
  });

  const createMutation = useMutation({
    mutationFn: async (payload: Record<string, any>) => {
      const { data, error } = await (sdk.POST as any)("/api/v1/{{service}}/{{pluralKebab}}", {
        body: payload,
      });
      if (error) throw new Error(error?.error?.message ?? "Failed to create {{entity}}");
      return data?.data ?? data;
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["{{service}}", "{{tableName}}"] });
      setModalOpen(false);
      setToast("Created {{entity}}");
    },
  });

  const deleteMutation = useMutation({
    mutationFn: async (id: string) => {
      const { error } = await (sdk.DELETE as any)(`/api/v1/{{service}}/{{pluralKebab}}/${id}`);
      if (error) throw new Error(error?.error?.message ?? "Failed to delete {{entity}}");
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["{{service}}", "{{tableName}}"] });
      setToast("Deleted {{entity}}");
    },
  });

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    createMutation.mutate(formState);
  };

  return (
    <div className="mth-stack" data-gap="6">
      <div className="mth-flex" data-justify="between" data-align="center" data-wrap>
        <div>
          <h1 className="pand-title">{{pluralTitle}}</h1>
          <p className="pand-subtitle">
            Manage {{pluralTitle}} (<code>/api/v1/{{service}}/{{pluralKebab}}</code>)
          </p>
        </div>
        <mth-button variant="solid" onmth-press={() => setModalOpen(true)}>
          Create {{entity}}
        </mth-button>
      </div>

      <mth-card variant="outlined">
        <mth-search-input
          placeholder="Search {{pluralTitle}}..."
          clearable
          value={search}
          onmth-input={(e) => setSearch(e.detail.value)}
          onmth-clear={() => setSearch("")}
        />
      </mth-card>

      {isLoading ? (
        <mth-card variant="subtle">
          <p className="pand-subtitle">Loading {{pluralTitle}}...</p>
        </mth-card>
      ) : items.length === 0 ? (
        <mth-empty-state
          variant="card"
          heading="No {{pluralTitle}} yet"
          description="Create your first {{entity}} to get started."
        >
          <mth-button slot="actions" variant="solid" onmth-press={() => setModalOpen(true)}>
            Create {{entity}}
          </mth-button>
        </mth-empty-state>
      ) : (
        <div className="pand-table-wrap">
          <table className="pand-table">
            <thead>
              <tr>
{{#each fields}}
                <th>{{label}}</th>
{{/each}}
                <th className="pand-text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {items.map((item) => (
                <tr key={item.id}>
{{#each fields}}
                  <td>
                    {typeof item.{{name}} === "boolean" ? (
                      <mth-badge variant={item.{{name}} ? "success" : "neutral"} pill>
                        {item.{{name}} ? "Yes" : "No"}
                      </mth-badge>
                    ) : (
                      String(item.{{name}} ?? "—")
                    )}
                  </td>
{{/each}}
                  <td className="pand-text-right">
                    <mth-button
                      variant="danger"
                      size="sm"
                      onmth-press={() => deleteMutation.mutate(item.id)}
                    >
                      Delete
                    </mth-button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <mth-dialog
        open={modalOpen}
        modal
        label="Create {{entity}}"
        onmth-close={() => setModalOpen(false)}
      >
        <form onSubmit={handleSubmit} className="mth-stack" data-gap="4">
{{#each fields}}
{{#if isBoolean}}
          <mth-checkbox
            label="{{label}}"
            checked={Boolean(formState.{{name}})}
            onmth-change={(e) =>
              setFormState((s) => ({ ...s, {{name}}: e.detail.checked }))
            }
          />
{{else if isEnum}}
          <mth-select
            label="{{label}}"
            value={String(formState.{{name}} ?? "")}
            options={[
{{#each enumValues}}
              { label: "{{this}}", value: "{{this}}" },
{{/each}}
            ]}
            onmth-change={(e) =>
              setFormState((s) => ({ ...s, {{name}}: e.detail.value }))
            }
          />
{{else if isInt}}
          <mth-number-input
            label="{{label}}"
            value={
              formState.{{name}} === "" || formState.{{name}} === undefined
                ? ""
                : String(formState.{{name}})
            }
            onmth-input={(e) =>
              setFormState((s) => ({
                ...s,
                {{name}}: Number.isNaN(e.detail.valueAsNumber) ? 0 : e.detail.valueAsNumber,
              }))
            }
          />
{{else if isFloat}}
          <mth-number-input
            label="{{label}}"
            step={0.01}
            value={
              formState.{{name}} === "" || formState.{{name}} === undefined
                ? ""
                : String(formState.{{name}})
            }
            onmth-input={(e) =>
              setFormState((s) => ({
                ...s,
                {{name}}: Number.isNaN(e.detail.valueAsNumber) ? 0 : e.detail.valueAsNumber,
              }))
            }
          />
{{else}}
          <mth-input
            label="{{label}}"
            value={String(formState.{{name}} ?? "")}
            onmth-input={(e) =>
              setFormState((s) => ({ ...s, {{name}}: e.detail.value }))
            }
          />
{{/if}}
{{/each}}
          <div className="mth-flex" data-justify="end" data-gap="2">
            <mth-button variant="outline" type="button" onmth-press={() => setModalOpen(false)}>
              Cancel
            </mth-button>
            <mth-button
              type="submit"
              variant="solid"
              loading={createMutation.isPending}
              disabled={createMutation.isPending}
            >
              {createMutation.isPending ? "Saving..." : "Create"}
            </mth-button>
          </div>
        </form>
      </mth-dialog>

      <mth-toast
        open={Boolean(toast)}
        variant="success"
        message={toast ?? ""}
        closable
        onmth-close={() => setToast(null)}
      />
    </div>
  );
}
